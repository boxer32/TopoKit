{
  "name": "@topokit/cli",
  "version": "0.1.0",
  "description": "TopoKit CLI - Enterprise-grade topology-first contract system for LLM applications",
  "main": "dist/index.js",
  "bin": {
    "topokit-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "llm",
    "orchestration",
    "topology",
    "contracts",
    "enterprise",
    "cli"
  ],
  "author": "TopoKit Foundation <hello@topokit.dev>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "yaml": "^2.4.1",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/fs-extra": "^11.0.4",
    "@types/chokidar": "^2.1.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/topokit/topokit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/topokit/topokit/issues"
  },
  "homepage": "https://topokit.dev"
}
