# TopoKit Environment Configuration
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://topokit:password@localhost:5432/topokit
DB_HOST=localhost
DB_PORT=5432
DB_USER=topokit
DB_PASSWORD=your_password_here
DB_NAME=topokit

# Security
SECRET_KEY=change_this_to_a_random_32_character_string
JWT_SECRET_KEY=change_this_to_a_random_32_character_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Security Features
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_INPUT_SANITIZATION=true
ENABLE_PII_REDACTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ACCOUNT_LOCKOUT=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Account Lockout
MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# CORS
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# LLM Provider API Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Adapter Configuration
PINECONE_API_KEY=
WEAVIATE_URL=http://localhost:8080
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Monitoring
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics
LOG_LEVEL=INFO

# Audit Logging
AUDIT_LOG_ENCRYPTION=true
AUDIT_LOG_RETENTION_DAYS=2555

# Compliance
ENABLE_GDPR=true
ENABLE_CCPA=true
ENABLE_SOX=true
ENABLE_HIPAA=false

# Application
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# Redis (for context store)
REDIS_URL=redis://localhost:6379/0

# File Paths
LOG_DIR=./logs
AUDIT_LOG_DIR=./audit-logs

