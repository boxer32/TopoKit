===============================================================
RUNTIME GUARDS (SELF-CONTAINED)
===============================================================
function safeParseJSON(str){
  try { return {ok:true,data:JSON.parse(str)}; }
  catch(e){ return {ok:false,error:"MALFORMED_JSON"}; }
}

function validateResponseSchema(obj){
  if(typeof obj!=="object") return false;
  if(!("answer" in obj)) return false;
  if(!("confidence_pct" in obj)) return false;
  if(!("decision" in obj)) return false;
  if(!("rationale_short" in obj)) return false;
  if(!(obj.answer===null || typeof obj.answer==="string")) return false;
  if(!(obj.confidence_pct>=0 && obj.confidence_pct<=100)) return false;
  if(!(obj.decision==="answer" || obj.decision==="abstain")) return false;
  if(obj.rationale_short.length>280) return false;
  return true;
}

function enforceThreshold(resp, threshold){
  resp.decision = resp.confidence_pct >= threshold ? "answer" : "abstain";
  if(resp.decision==="abstain") resp.answer = null;
  return resp;
}


